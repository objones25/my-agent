# Hugging Face Inference Providers router — required.
HF_TOKEN=

# LangSmith tracing + evals. Both are required for tracing to switch on:
# an API key alone deliberately does nothing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=my-agent

# W&B Weave tracing + evals.
WANDB_API_KEY=

# Optional. Read by ModelConfig.from_env(); defaults to DEFAULT_MODEL_ID in agent.py.
# MODEL_ID=openai/gpt-oss-120b
