# Hugging Face Inference Providers router — required.
HF_TOKEN=

# LangSmith tracing + evals. Both are required for tracing to switch on:
# an API key alone deliberately does nothing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=my-agent

# W&B Weave tracing + evals. WANDB_API_KEY alone switches Weave on;
# WEAVE_PROJECT is optional and defaults to "my-agent".
WANDB_API_KEY=
WEAVE_PROJECT=my-agent

# Optional. How hard the model thinks: none, minimal, low, medium, high, xhigh.
# Unset means the provider's default, which is not the cheapest (F17).
# REASONING_EFFORT=low

# Optional. Read by ModelConfig.from_env(); defaults to DEFAULT_MODEL_ID in agent.py.
# MODEL_ID=openai/gpt-oss-120b
