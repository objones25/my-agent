# Hugging Face Inference Providers router — required.
HF_TOKEN=

# LangSmith tracing + evals. Both are required for tracing to switch on:
# an API key alone deliberately does nothing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=my-agent

# W&B Weave tracing + evals. WANDB_API_KEY alone switches Weave on;
# WEAVE_PROJECT is optional and defaults to "my-agent".
WANDB_API_KEY=
WEAVE_PROJECT=my-agent

# Optional. Weave's LangChain integration is gated on this and weave sets it to
# "true" itself when unset, so you normally need not. Set it to a falsey value
# and WeaveTracing.activate() will fail loudly rather than trace nothing.
# WEAVE_TRACE_LANGCHAIN=true

# Optional. How hard the model thinks: low, medium or high -- those three and
# no others. The router documents none/minimal/xhigh and answers 400 for all
# three. Unset is not "off" and not "between": it measured token-for-token
# identical to medium (F26).
# REASONING_EFFORT=low

# Optional. Read by ModelConfig.from_env(); defaults to model.DEFAULT_MODEL.
# The `:groq` suffix pins the provider -- an unsuffixed id means `:fastest`,
# which is what produced the 429s in F46. Policies: :fastest, :cheapest,
# :preferred.
# MODEL_ID=openai/gpt-oss-120b:groq

# Optional model settings. Every ModelConfig field is reachable from here — a
# load-time check asserts it, so a new field cannot go missing (F19).
# MODEL_BASE_URL=https://router.huggingface.co/v1   # or a dedicated endpoint's /v1
# MODEL_TEMPERATURE=0.0
# MODEL_TIMEOUT_S=120
# MODEL_MAX_RETRIES=2

# Weave's shutdown wait is NOT configurable -- see F23 before trying. The delay
# is FLUSH_TIMEOUT_SECONDS, hardcoded at 300s inside weave's CallBatchProcessor,
# and neither WEAVE_RETRY_* (wrong mechanism) nor WEAVE_USE_CALLS_COMPLETE=false
# (weave auto-upgrades projects already written in that mode) avoids it.
